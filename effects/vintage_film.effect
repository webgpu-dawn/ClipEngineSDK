# Vintage Film Effect Configuration
# Old movie look with sepia tone, film grain, scratches, and vignette

[Effect]
name = VintageFilm
vertexShader = effects/shaders/fullscreen.vert.wgsl
fragmentShader = effects/shaders/vintage_film.frag.wgsl
inputBinding = true

[Parameter]
name = sepiaIntensity
type = float
default = 0.8
min = 0.0
max = 1.0
description = Sepia tone intensity (brownish vintage color)

[Parameter]
name = grainIntensity
type = float
default = 0.15
min = 0.0
max = 1.0
description = Film grain noise intensity

[Parameter]
name = scratchIntensity
type = float
default = 0.3
min = 0.0
max = 1.0
description = Vertical scratch intensity

[Parameter]
name = vignetteIntensity
type = float
default = 0.6
min = 0.0
max = 1.0
description = Edge darkening (vignette) intensity

[Parameter]
name = iTime
type = float
default = 0.0
min = 0.0
max = 10000.0
description = Time for animation (auto-filled)
